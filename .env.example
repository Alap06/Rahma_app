# Variables d'environnement pour FitPulse Store

# API Configuration (pour future intégration backend)
REACT_APP_API_URL=https://api.fitpulse.com
REACT_APP_API_TIMEOUT=10000

# Environment
NODE_ENV=development

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_DARK_MODE=true

# Expo Configuration
EXPO_PUBLIC_APP_NAME=FitPulse Store
EXPO_PUBLIC_VERSION=1.0.0

# Payment Gateway (pour future intégration)
REACT_APP_STRIPE_KEY=pk_test_YOUR_STRIPE_KEY
REACT_APP_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID

# Firebase (optionnel)
REACT_APP_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
REACT_APP_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
REACT_APP_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# Analytics (optionnel)
REACT_APP_SEGMENT_KEY=YOUR_SEGMENT_KEY
REACT_APP_SENTRY_DSN=YOUR_SENTRY_DSN

# Debug
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=info
